source "https://rubygems.org"
gem "rails", "~> 8.0"
gem "propshaft"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 5.0"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "jbuilder"
gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"
gem "bootsnap", require: false
# kamal is in a stock `rails new` Gemfile but is left out here: its
# bcrypt_pbkdf dependency ships darwin builds that refuse Ruby 3.4, which
# trips https://github.com/ruby/rubygems/pull/9960 when locking from Linux.
gem "thruster", require: false
gem "image_processing", "~> 1.2"
group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end
group :development do
  gem "web-console"
end
group :test do
  gem "capybara"
  gem "selenium-webdriver"
end
